[Unit]
Description=Hubra Vault Rebalancer (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace-blaze/vaults-rebalancer

EnvironmentFile=/root/.openclaw/workspace-blaze/vaults-rebalancer/.env
EnvironmentFile=/root/.openclaw/workspace-blaze/vaults-rebalancer/.env-%i
Environment=ENV_FILE=.env-%i

ExecStart=/usr/bin/node dist/src/index.js

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
