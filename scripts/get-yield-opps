#!/bin/bash
# get-yield-opps — fetch yield opportunities from Dialect API
# usage: ./get-yield-opps [SYMBOL]

# Dialect client key — same credential the rebalancer uses; never hardcode it here.
API_KEY="${YIELD_MARKETS_API:?set YIELD_MARKETS_API (see .env)}"
API_URL="https://markets.dial.to/api/v0/markets?type=yield&provider=kamino,jupiter"

SYMBOL="${1:-}"

fetch_data() {
curl -s "$API_URL" -H "x-dialect-client-key: $API_KEY"
}

format_output() {
awk -F'\t' '{printf "%-8s %-10s %-10s %-10s %-8s %s\n", $1, $2, $3, $4, $5, $6}'
}

if [[ -z "$SYMBOL" ]]; then
fetch_data | jq -r '
.markets
| group_by(.token.symbol)
| map(sort_by(-.depositApy))
| flatten
| ["TOKEN", "APY", "TYPE", "PROVIDER", "TVL", "ID"],
(.[] | [
.token.symbol,
"\((.depositApy * 10000 | floor) / 100)%",
.type,
.provider.name,
"\((.totalDepositUsd / 1e6 * 100 | floor) / 100)M",
.id
])
| @tsv' | format_output
else
fetch_data | jq -r --arg sym "$SYMBOL" '
.markets
| [.[] | select(.token.symbol == $sym)]
| sort_by(-.depositApy)
| ["TOKEN", "APY", "TYPE", "PROVIDER", "TVL", "ID"],
(.[] | [
.token.symbol,
"\((.depositApy * 10000 | floor) / 100)%",
.type,
.provider.name,
"\((.totalDepositUsd / 1e6 * 100 | floor) / 100)M",
.id
])
| @tsv' | format_output
fi
